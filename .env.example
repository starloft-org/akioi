# 本文件为配置模板，复制为 .env 后按实际环境填写
# DB_PASSWORD / REDIS_PASSWORD / JWT_SECRET 必须修改为强密钥
# ADMIN_INIT_PASSWORD 是首次启动时创建的默认管理员密码，留空则使用内置默认值，上线后必须立即修改
# HOST_TESTDATA_DIR 与 HOST_WORK_DIR 必须填宿主机 ./data/testdata、./data/work 的绝对路径（judge 在同级容器里挂载测试数据时使用）
# 微信登录 WECHAT_ENABLED 为 1 时启用，为 2 时后端不构建该登录方式
# 数据库名固定为 akioi，与 docker-compose 的 MYSQL_DATABASE 一致，不需要在 .env 中配置
# FRONTEND_PORT 由 docker-compose 读取，决定前端容器映射到宿主机的端口

# 1 应用
APP_NAME=AKIOI
APP_ENV=production
SERVER_ADDR=:8080
FRONTEND_PORT=3001

# 2 数据库
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10

# 3 Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# 4 鉴权与注册
JWT_SECRET=
JWT_TTL_HOURS=168
REGISTER_ENABLED=1
REGISTER_INVITE_CODE=
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=

# 5 微信登录
WECHAT_ENABLED=2
WECHAT_APPID=
WECHAT_APPSECRET=
WECHAT_REDIRECT_URI=

# 6 限流与提交
RATE_LIMIT_PER_MINUTE=300
SUBMIT_INTERVAL_SEC=10

# 7 判题沙箱
JUDGE_CONCURRENCY=2
JUDGE_QUEUE_KEY=akioi:judge:queue
JUDGE_TASK_TIMEOUT_SEC=300
SANDBOX_IMAGE=akioi-sandbox:latest
DOCKER_BIN=docker
TESTDATA_DIR=/app/testdata
HOST_TESTDATA_DIR=
WORK_DIR=/app/work
HOST_WORK_DIR=
COMPILE_TIMEOUT_SEC=20
COMPILE_MEMORY_MB=1024
OUTPUT_LIMIT_MB=64
TMPFS_MB=64
MAX_TESTCASES=100
CPP_COMPILER=g++
CPP_STD=c++14
CPP_FLAGS=-O2
C_COMPILER=gcc
C_STD=c11
C_FLAGS=-O2

# 8 日志
LOG_DIR=/app/logs
LOG_MAX_MB=100

# 9 上传
UPLOAD_DIR=/app/uploads
MAX_AVATAR_MB=2
MAX_TESTDATA_MB=512

# 10 跨域
CORS_ALLOW_ORIGINS=
