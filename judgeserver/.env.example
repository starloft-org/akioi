# 本文件为配置模板，复制为 .env 后按实际环境填写
# 评测节点自带 MySQL 与 Redis，库名默认 akioi_judge，与主站完全隔开
# DB_PASSWORD / REDIS_PASSWORD 由 docker compose 读取，用于初始化本机容器
# MAIN_BASE_URL 是主站地址，评测结果通过它回传；同机部署填本机内网 IP，跨机填主站地址
# JUDGE_SYNC_SECRET 必须与主站 .env 一致：接收任务、回传结果都靠它鉴权
# HOST_TESTDATA_DIR 与 HOST_WORK_DIR 必须填本机 ./data/testdata、./data/work 的绝对路径（judge 在同级容器里挂载时使用）

# 1 数据库（本机容器，不连主站）
DB_HOST=mysql
DB_PORT=3306
DB_NAME=akioi_judge
DB_USER=root
DB_PASSWORD=
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5

# 2 Redis（本机容器，用于本地任务队列与限流）
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# 3 回传主站
# 主站默认启用 HTTPS（80 只做 ACME 校验与 301 跳转），这里必须填 https://域名，
# 否则 POST 会被重定向成 GET，评测结果回传失败
MAIN_BASE_URL=

# 4 判题沙箱
# JUDGE_CONCURRENCY 为单节点并发评测数，按本机核数配置
JUDGE_CONCURRENCY=2
JUDGE_QUEUE_KEY=akioi:judge:queue
JUDGE_TASK_TIMEOUT_SEC=300
SANDBOX_IMAGE=akioi-sandbox:latest
DOCKER_BIN=docker
TESTDATA_DIR=/app/testdata
HOST_TESTDATA_DIR=
WORK_DIR=/app/work
HOST_WORK_DIR=
COMPILE_TIMEOUT_SEC=20
COMPILE_MEMORY_MB=1024
OUTPUT_LIMIT_MB=64
TMPFS_MB=64
CPP_COMPILER=g++
CPP_STD=c++14
CPP_FLAGS=-O2
C_COMPILER=gcc
C_STD=c11
C_FLAGS=-O2

# 5 控制面（接收主站推送的测试数据与评测任务）
# JUDGE_SYNC_SECRET 留空时不监听接收接口；必须与主站 .env 中的取值一致
# 监听端口固定 9000，宿主机也映射到 9000，主站按 http://<本机 IP>:9000 访问
JUDGE_LISTEN_ADDR=:9000
JUDGE_LISTEN_PORT=9000
JUDGE_SYNC_SECRET=
MAX_TESTDATA_MB=512

# 6 日志
LOG_DIR=/app/logs
LOG_MAX_MB=100
