# 本文件为配置模板，复制为 .env 后按实际环境填写
# DB_HOST / REDIS_ADDR 指向主站的 MySQL 与 Redis：与主站同机部署填 host.docker.internal（主站需把 DB_BIND_ADDR / REDIS_BIND_ADDR 设为 0.0.0.0），跨机部署填主站内网 IP
# DB_PASSWORD / REDIS_PASSWORD 必须与主站 .env 中的取值一致
# HOST_TESTDATA_DIR 与 HOST_WORK_DIR 必须填本机 ./data/testdata、./data/work 的绝对路径（judge 在同级容器里挂载时使用）
# TESTDATA_DIR 下的题目数据必须与主站一致，否则评测会把题目判为 SystemError
# JUDGE_QUEUE_KEY 必须与主站 .env 一致，否则任务投递后无人消费

# 1 数据库
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5

# 2 Redis
REDIS_ADDR=host.docker.internal:6379
REDIS_PASSWORD=
REDIS_DB=0

# 3 判题沙箱
# JUDGE_CONCURRENCY 为单节点并发评测数，按本机核数配置
JUDGE_CONCURRENCY=2
JUDGE_QUEUE_KEY=akioi:judge:queue
JUDGE_TASK_TIMEOUT_SEC=300
SANDBOX_IMAGE=akioi-sandbox:latest
DOCKER_BIN=docker
TESTDATA_DIR=/app/testdata
HOST_TESTDATA_DIR=
WORK_DIR=/app/work
HOST_WORK_DIR=
COMPILE_TIMEOUT_SEC=20
COMPILE_MEMORY_MB=1024
OUTPUT_LIMIT_MB=64
TMPFS_MB=64
CPP_COMPILER=g++
CPP_STD=c++14
CPP_FLAGS=-O2
C_COMPILER=gcc
C_STD=c11
C_FLAGS=-O2

# 4 控制面（接收主站推送的测试数据）
# JUDGE_SYNC_SECRET 留空时不监听接收接口；必须与主站 .env 中的取值一致
# 接收端口只需对主站开放，不要暴露到公网
JUDGE_LISTEN_ADDR=:9100
JUDGE_SYNC_SECRET=
MAX_TESTDATA_MB=512

# 5 日志
LOG_DIR=/app/logs
LOG_MAX_MB=100
