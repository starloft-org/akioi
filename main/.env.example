# 本文件为配置模板，复制为 .env 后按实际环境填写
# DB_PASSWORD / REDIS_PASSWORD / JWT_SECRET 必须修改为强密钥
# ADMIN_INIT_PASSWORD 是首次启动创建管理员所需的密码，必须设置 8 到 64 位；管理员已存在后不再使用
# 数据库名固定为 akioi，与 docker-compose 的 MYSQL_DATABASE 一致，不需要在 .env 中配置
# FRONTEND_PORT 由 docker-compose 读取，决定前端容器映射到宿主机的端口；
# 默认 80，即直接占用宿主机 80，浏览器用 http://域名/ 访问（HTTP 明文，不需要证书）；
# 若宿主机 80 已被其它服务占用，改为 3001 等端口，再由上层反向代理转发
# DB_BIND_ADDR / REDIS_BIND_ADDR 由 docker-compose 读取，决定 MySQL / Redis 在宿主机的绑定地址；
# 评测节点已自带数据库与队列，主站不需要对评测节点开放这两个端口，保持 127.0.0.1 即可；
# 只有需要从宿主机或其它机器直连调试时才改为 0.0.0.0 或内网 IP，并用防火墙限制来源

# 1 基础服务
APP_ENV=production
SERVER_ADDR=:8080
FRONTEND_PORT=80

# 2 数据库
DB_HOST=mysql
DB_PORT=3306
DB_BIND_ADDR=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10

# 3 Redis
REDIS_ADDR=redis:6379
REDIS_BIND_ADDR=127.0.0.1
REDIS_PASSWORD=
REDIS_DB=0

# 4 鉴权、注册与第三方服务密钥
JWT_SECRET=
# 第三方密钥属于敏感信息，仍由环境变量保存；留空表示尚未配置服务。
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=
WECHAT_APPID=
WECHAT_APPSECRET=
SMS_API_KEY=
SMS_API_SECRET=
# SMTP 邮件发送：配合后台「启用邮件服务」开关使用，465 端口走隐式 TLS，其他端口尝试 STARTTLS
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# 5 判题与文件目录
# JUDGE_QUEUE_KEY 仅评测节点本地队列使用，主站不再读写该队列
JUDGE_QUEUE_KEY=akioi:judge:queue
TESTDATA_DIR=/app/testdata
# JUDGE_SYNC_SECRET 必须与各评测节点 .env 中的取值一致
JUDGE_SYNC_SECRET=

# 6 日志与上传目录
LOG_DIR=/app/logs
LOG_MAX_MB=100
UPLOAD_DIR=/app/uploads

# 站名、注册/登录开关、短信接口与模板、登录时效、限流、上传限制、
# 评测节点、同步超时和跨域来源等非敏感设置，首次启动后在“管理后台 → 系统设置”中维护。
