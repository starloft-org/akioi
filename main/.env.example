# 本文件为配置模板，复制为 .env 后按实际环境填写
# .env 只保留启动必须项：数据库、Redis、管理员初始化、端口与容器内路径。
# 登录密钥、微信、短信、邮件、验证码与评测节点同步密钥已改为保存在数据库中，
# 首次启动会把本文件中仍然存在的旧键导入一次，之后请到「管理后台 → 系统设置 → 密钥与集成」维护。
# DB_PASSWORD / REDIS_PASSWORD 必须修改为强密钥
# ADMIN_INIT_PASSWORD 是首次启动创建管理员所需的密码，必须设置 8 到 64 位；管理员已存在后不再使用
# 数据库名固定为 akioi，与 docker-compose 的 MYSQL_DATABASE 一致，不需要在 .env 中配置
# FRONTEND_PORT 由 docker-compose 读取，决定前端容器映射到宿主机的端口；
# 默认 80，即直接占用宿主机 80，浏览器用 http://域名/ 访问（HTTP 明文，不需要证书）；
# 若宿主机 80 已被其它服务占用，改为 3001 等端口，再由上层反向代理转发
# DB_BIND_ADDR / REDIS_BIND_ADDR 由 docker-compose 读取，决定 MySQL / Redis 在宿主机的绑定地址；
# 评测节点已自带数据库与队列，主站不需要对评测节点开放这两个端口，保持 127.0.0.1 即可；
# 只有需要从宿主机或其它机器直连调试时才改为 0.0.0.0 或内网 IP，并用防火墙限制来源

# 1 基础服务
APP_ENV=production
SERVER_ADDR=:8080
FRONTEND_PORT=80

# 2 数据库
DB_HOST=mysql
DB_PORT=3306
DB_BIND_ADDR=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10

# 3 Redis
REDIS_ADDR=redis:6379
REDIS_BIND_ADDR=127.0.0.1
REDIS_PASSWORD=
REDIS_DB=0

# 4 管理员初始化与登录密钥
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=
# 登录密钥用于签发 JWT：首次启动自动生成并写入数据库，留空即可；
# 如需指定固定值，取消下面一行的注释并填写，同样只在首次启动时导入一次。
# JWT_SECRET=

# 5 判题与文件目录
TESTDATA_DIR=/app/testdata
# 判题队列键名，主站与评测节点必须一致；默认 akioi:judge:queue，未改动时两端都可省略
# JUDGE_QUEUE_KEY=akioi:judge:queue
# 评测节点同步密钥：主站首次启动导入数据库，之后在后台修改；
# 必须与各评测节点 .env 中的 JUDGE_SYNC_SECRET 保持一致，否则评测结果无法回传。
JUDGE_SYNC_SECRET=

# 6 日志与上传目录
LOG_DIR=/app/logs
LOG_MAX_MB=100
UPLOAD_DIR=/app/uploads
# 数据库备份文件存放目录，后台「数据备份」页面会在这里生成与下载 .sql.gz
BACKUP_DIR=/app/backups

# 已迁移到数据库的配置（首次启动会从下面这些键导入一次，之后以后台设置为准）：
#   WECHAT_APPID / WECHAT_APPSECRET / WECHAT_OPEN_APPID / WECHAT_OPEN_APPSECRET
#   SMS_API_KEY / SMS_API_SECRET / CAPTCHA_API_KEY / CAPTCHA_API_SECRET
#   SMTP_HOST / SMTP_PORT / SMTP_USERNAME / SMTP_PASSWORD / SMTP_FROM
#
# 站名、注册/登录开关、短信接口与模板、登录时效、限流、上传限制、
# 评测节点、同步超时和跨域来源等设置，首次启动后在「管理后台 → 系统设置」中维护。
