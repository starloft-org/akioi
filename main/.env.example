# 本文件为配置模板，复制为 .env 后按实际环境填写
# DB_PASSWORD / REDIS_PASSWORD / JWT_SECRET 必须修改为强密钥
# ADMIN_INIT_PASSWORD 是首次启动时创建的默认管理员密码，留空则使用内置默认值，上线后必须立即修改
# 微信登录 WECHAT_ENABLED 为 1 时启用，为 2 时后端不构建该登录方式
# 数据库名固定为 akioi，与 docker-compose 的 MYSQL_DATABASE 一致，不需要在 .env 中配置
# FRONTEND_PORT 由 docker-compose 读取，决定前端容器映射到宿主机的端口
# DB_BIND_ADDR / REDIS_BIND_ADDR 由 docker-compose 读取，决定 MySQL / Redis 在宿主机的绑定地址；
# 独立评测节点需要直连主站时改为内网 IP，默认只绑本机回环

# 1 应用
APP_NAME=AKIOI
APP_ENV=production
SERVER_ADDR=:8080
FRONTEND_PORT=3001

# 2 数据库
DB_HOST=mysql
DB_PORT=3306
DB_BIND_ADDR=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10

# 3 Redis
REDIS_ADDR=redis:6379
REDIS_BIND_ADDR=127.0.0.1
REDIS_PASSWORD=
REDIS_DB=0

# 4 鉴权与注册
JWT_SECRET=
JWT_TTL_HOURS=168
REGISTER_ENABLED=1
REGISTER_INVITE_CODE=
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=

# 5 微信登录
WECHAT_ENABLED=2
WECHAT_APPID=
WECHAT_APPSECRET=
WECHAT_REDIRECT_URI=

# 6 限流与提交
RATE_LIMIT_PER_MINUTE=300
SUBMIT_INTERVAL_SEC=10

# 7 判题队列与测试数据
# JUDGE_QUEUE_KEY 必须与 judgeserver/.env 一致，否则任务投递后无人消费
JUDGE_QUEUE_KEY=akioi:judge:queue
TESTDATA_DIR=/app/testdata
MAX_TESTCASES=100

# 8 评测节点同步
# 测试数据上传/清空后依次推送到下列评测节点，留空表示不推送（单机部署）
# 格式为逗号分隔的节点地址，如 http://10.0.0.11:9100,http://10.0.0.12:9100
# JUDGE_SYNC_SECRET 必须与各评测节点 .env 中的取值一致
JUDGE_NODE_ENDPOINTS=
JUDGE_SYNC_SECRET=
JUDGE_SYNC_TIMEOUT_SEC=120

# 9 日志
LOG_DIR=/app/logs
LOG_MAX_MB=100

# 10 上传
UPLOAD_DIR=/app/uploads
MAX_AVATAR_MB=2
MAX_TESTDATA_MB=512

# 11 跨域
CORS_ALLOW_ORIGINS=
